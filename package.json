{
  "name": "openbeacon",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@types/react": "~19.2.14",
      "@types/react-dom": "~19.2.3"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "emulators": "python3 scripts/derby-emulators.py",
    "emulators:versions": "python3 scripts/derby-emulators.py --android-versions",
    "prepare": "husky",
    "build": "turbo build",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:fix": "bun fmt",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "bun run format:check && bun run lint",
    "check:fix": "bun run format:fix && bun run lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "benchmark:offline-queue-storage": "bash scripts/benchmark-offline-queue-storage.sh",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "ci": "bun run check && bun run typecheck && bun run test && bun test scripts && python3 -B -m unittest discover -s scripts && bun scripts/warn-skipped-integration-tests.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "husky": "^9.1.7",
    "turbo": "2.9.14"
  }
}
