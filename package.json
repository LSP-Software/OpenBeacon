{
  "name": "openbeacon",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check": "turbo check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "ci": "bun run typecheck && bun run check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "turbo": "2.7.6",
    "typescript": "5.9.3"
  }
}