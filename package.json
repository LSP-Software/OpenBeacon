{
  "name": "openbeacon",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "packageManager": "bun@1.4.4-canary.20261028.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "prepare": "husky",
    "build": "turbo build",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:fix": "bun fmt",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "bun run format:check && bun run lint",
    "check:fix": "bun run format:fix && bun run lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "ci": "bun run typecheck && bun run check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "husky": "^9.1.7",
    "turbo": "2.9.14"
  }
}
