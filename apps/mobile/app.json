{
  "expo": {
    "name": "OpenBeacon",
    "slug": "open-beacon",
    "description": "Privacy-first family location sharing. You own your data.",
    "version": "1.36.0",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0FA",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#090911"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.openbeacon.app",
      "buildNumber": "69",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090911"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "net.openbeacon.app",
      "versionCode": 69,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "scheme": "openbeacon",
    "plugins": [
      ["expo-router", { "sitemap": false }],
      ["expo-secure-store", { "configureAndroidBackup": false }],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.0",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withMapFonts.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan group invitation QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your precise location to center the map and prepare private family location sharing.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your precise location in the background so you can share your location privately with your family.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "./modules/openbeacon-tracking/app.plugin.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "microphonePermission": false
        }
      ],
      "./plugins/withReleaseSigning.js",
      "./plugins/withPodDeploymentTarget.js",
      "./plugins/withFirebasePush.js"
    ]
  }
}
