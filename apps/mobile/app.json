{
  "expo": {
    "name": "Open Beacon",
    "slug": "open-beacon",
    "description": "Privacy-first family location sharing. You own your data.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0FA",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#090911"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.openbeacon.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090911"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "net.openbeacon.app",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "openbeacon",
    "plugins": ["expo-router", "expo-secure-store", "@maplibre/maplibre-react-native"]
  }
}
