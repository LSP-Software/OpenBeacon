{
  "expo": {
    "name": "Open Beacon",
    "slug": "open-beacon",
    "description": "Privacy-first family location sharing. You own your data.",
    "version": "1.6.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0FA",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#090911"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.openbeacon.app",
      "buildNumber": "16"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090911"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.openbeacon.app",
      "versionCode": 16
    },
    "scheme": "openbeacon",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withMapFonts.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan group invitation QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your precise location to center the map and prepare private family location sharing.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your precise location in the background so you can share your location privately with your family.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./modules/openbeacon-tracking/app.plugin.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos."
        }
      ]
    ]
  }
}
