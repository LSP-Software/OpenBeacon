EXPO_PUBLIC_DEV_API_URL=http://192.168.0.x:3000 # Replace with your local IP address
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=              # Required for native Google sign-in with Better Auth
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=              # Required by the native iOS Google SDK
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=             # Reversed iOS client ID, used by the Expo config plugin
