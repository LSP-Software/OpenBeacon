{
  "name": "@openbeacon/mobile",
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --android --ios",
    "android": "expo prebuild -p android && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "bun run typecheck && bun run check && bun run test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.4",
    "@openbeacon/api": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@trpc/client": "^11.12.0",
    "@trpc/tanstack-react-query": "^11.12.0",
    "@types/node": "^25.4.0",
    "better-auth": "^1.5.4",
    "expo": "~54.0.32",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-glass-effect": "~0.1.9",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-linking": "~8.0.11",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-mmkv": "^4.2.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
