{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --android --ios",
    "android": "expo prebuild -p android && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "ci": "bun run typecheck && bun run check && bun run test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.4",
    "@types/node": "^25.4.0",
    "better-auth": "^1.5.4",
    "expo": "~54.0.32",
    "expo-constants": "~18.0.13",
    "expo-glass-effect": "^55.0.7",
    "expo-linking": "~8.0.11",
    "expo-network": "^55.0.8",
    "expo-router": "~6.0.22",
    "expo-secure-store": "^55.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "^55.0.9",
    "nativewind": "^4.2.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mmkv": "^4.2.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "^55.0.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}