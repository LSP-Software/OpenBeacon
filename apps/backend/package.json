  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../.. --env-file=.env --hot apps/backend/src/index.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "biome lint .",
    "typecheck": "bun check",
    "test": "bun test --isolate",
    "ci": "bun run typecheck && bun run format:check && bun run lint"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.4",
    "@openbeacon/api": "workspace:*",
    "@openbeacon/cache": "workspace:*",
    "@openbeacon/database": "workspace:*",
    "@openbeacon/shared": "workspace:*",
    "@openbeacon/auth": "workspace:*",
    "@openbeacon/schemas": "workspace:*",
    "@prisma/adapter-pg": "^7.4.2",
    "@t3-oss/env-core": "^0.13.10",
    "@trpc/server": "^11.12.0",
    "better-auth": "^1.5.4",
    "hono": "^4.12.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3"
  }
}
