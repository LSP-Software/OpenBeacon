{
  "name": "@openbeacon/backend",
  "private": true,
  "scripts": {
    "dev": "bun run --env-file=../../.env --hot src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "ci": "bun run typecheck && bun run check && bun run test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.4",
    "@openbeacon/database": "workspace:*",
    "@prisma/adapter-pg": "^7.4.2",
    "@t3-oss/env-core": "^0.13.10",
    "better-auth": "^1.5.4",
    "hono": "^4.12.5",
    "ioredis": "^5.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3"
  }
}
