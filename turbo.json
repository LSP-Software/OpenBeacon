{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "REDIS_HASH_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "IMAGES_S3_ENDPOINT",
    "IMAGES_S3_REGION",
    "IMAGES_S3_ACCESS_KEY_ID",
    "IMAGES_S3_ACCESS_KEY",
    "IMAGES_S3_BUCKET_NAME",
    "IMAGES_S3_FORCE_PATH_STYLE",
    "IMAGES_S3_CDN_URL",
    "MAX_IMAGE_FILE_SIZE",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "MAP_S3_ENDPOINT",
    "MAP_S3_REGION",
    "MAP_S3_ACCESS_KEY_ID",
    "MAP_S3_ACCESS_KEY",
    "MAP_S3_BUCKET_NAME",
    "MAP_S3_FORCE_PATH_STYLE",
    "SELF_HOSTED",
    "SERVER_NAME",
    "RESEND_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_REQUIRE_TLS",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "EMAIL_FROM",
    "EMAIL_CONSOLE",
    "JAVA_HOME",
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "OPENBEACON_INTEGRATION",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate"],
      "outputs": []
    },
    "@openbeacon/mobile#test": {
      "dependsOn": ["^db:generate"],
      "outputs": [],
      "env": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/test-offline-tracking-queue.sh"]
    },
    "typecheck": {
      "dependsOn": ["db:generate", "^db:generate"],
      "outputs": []
    },
    "db:generate": {
      "dependsOn": ["^db:generate"],
      "outputs": ["generated/**"]
    }
  }
}
