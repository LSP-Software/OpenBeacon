BETTER_AUTH_SECRET=                    # Min 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000  # Public URL of the backend
GOOGLE_CLIENT_ID=                      # Optional, enables Google OAuth when paired with GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=                  # Optional, Google OAuth client secret for your backend
DATABASE_URL=postgresql://openbeacon:openbeacon@localhost:5432/openbeacon
REDIS_URL=redis://localhost:6379
SERVER_NAME=OpenBeacon                 # Optional, public server name; defaults to OpenBeacon
SELF_HOSTED=true                       # Optional, defaults to true; only the OpenBeacon hosted API sets this to false
OPENBEACON_API_PORT=3000               # Optional, defaults to 3000
OPENBEACON_API_HOSTNAME=0.0.0.0        # Optional, defaults to 0.0.0.0
TRUSTED_PROXY_PROVIDER=none            # Optional, defaults to none; proxy headers are ignored unless set to cloudflare or trusted-proxy
CLOUDFLARE_ORIGIN_SECRET=              # Required when TRUSTED_PROXY_PROVIDER=cloudflare-authenticated; at least 32 characters

# S3 B2 Storage
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com  # Optional, defaults to us-east-005
S3_REGION=us-east-005                               # Optional, defaults to us-east-005
S3_ACCESS_KEY_ID=                                   # Required
S3_ACCESS_KEY=                                      # Required
S3_BUCKET_NAME=                                     # Required
S3_CDN_URL=https://cdn.openbeacon.net/file          # Optional, defaults to https://cdn.openbeacon.net/file

# Image Upload Limits
MAX_IMAGE_FILE_SIZE=5242880            # Optional, defaults to 5MB (5242880 bytes)

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PM_TILES_KEY=
