BETTER_AUTH_SECRET=                    # Min 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000  # Public URL of the backend
GOOGLE_CLIENT_ID=                      # Optional, enables Google OAuth when paired with GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=                  # Optional, Google OAuth client secret for your backend
DATABASE_URL=postgresql://openbeacon:openbeacon@localhost:5432/openbeacon
REDIS_URL=redis://localhost:6379
SERVER_NAME=OpenBeacon                 # Optional, public server name; defaults to OpenBeacon
SELF_HOSTED=true                       # Optional, defaults to true; set false only on the hosted API, or locally to test feedback
OPENBEACON_API_PORT=3000               # Optional, defaults to 3000
OPENBEACON_API_HOSTNAME=0.0.0.0        # Optional, defaults to 0.0.0.0
TRUSTED_PROXY_PROVIDER=none            # Optional, defaults to none; trusted-proxy uses the last X-Forwarded-For hop; cloudflare trusts CF-Connecting-IP, so only use it when the origin is reachable solely through Cloudflare
CLOUDFLARE_ORIGIN_SECRET=              # Required when TRUSTED_PROXY_PROVIDER=cloudflare-authenticated; at least 32 characters

# Email (optional). Configure Resend or SMTP, not both. Leave both empty to turn email off.
RESEND_API_KEY=                        # Resend API key; a sending-only key works
SMTP_HOST=                             # SMTP server hostname
SMTP_PORT=                             # Optional, defaults to 465 when SMTP_SECURE=true, otherwise 587
SMTP_SECURE=                           # Optional, true for implicit TLS; defaults to true only on port 465
SMTP_REQUIRE_TLS=                      # Optional, defaults to true: refuse to send unless STARTTLS succeeds; false allows plaintext for a local relay
SMTP_USER=                             # Optional, set together with SMTP_PASSWORD
SMTP_PASSWORD=                         # Optional, set together with SMTP_USER
EMAIL_FROM=                            # Sender address, required with Resend or SMTP; emails come from "OpenBeacon <EMAIL_FROM>"
EMAIL_CONSOLE=                         # Development only: true prints emails to the backend log instead of sending them; refused unless NODE_ENV is development or test
EMAIL_CODE_IP_LIMIT=                   # Optional, defaults to false; true also limits each IP to 20 code requests an hour, which can block users sharing an IP such as carrier NAT

# S3 B2 Storage
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com  # Optional, defaults to us-east-005
S3_REGION=us-east-005                               # Optional, defaults to us-east-005
S3_ACCESS_KEY_ID=                                   # Required
S3_ACCESS_KEY=                                      # Required
S3_BUCKET_NAME=                                     # Required
S3_CDN_URL=https://cdn.openbeacon.net/file          # Optional, defaults to https://cdn.openbeacon.net/file

# Image Upload Limits
MAX_IMAGE_FILE_SIZE=5242880            # Optional, defaults to 5MB (5242880 bytes)

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PM_TILES_KEY=
