# Min 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the backend
BETTER_AUTH_URL=http://localhost:3000

# Optional, enables Google OAuth when paired with GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=

# Optional, Google OAuth client secret for your backend
GOOGLE_CLIENT_SECRET=

DATABASE_URL=postgresql://openbeacon:openbeacon@localhost:5432/openbeacon
# If your Redis user has an ACL, startup checks it and prints the ACL SETUSER command for anything missing
REDIS_URL=redis://localhost:6379

# Min 32 chars, generate with: openssl rand -base64 32
REDIS_HASH_SECRET=

# Optional, public server name; defaults to OpenBeacon
SERVER_NAME=OpenBeacon

# Optional, plain text of at most 280 characters shown to people whose app needs updating; a longer value is ignored
CLIENT_UPDATE_MESSAGE=

# Optional, defaults to true; set false only on the hosted API, or locally to test feedback
SELF_HOSTED=true

# Optional, defaults to 3000
OPENBEACON_API_PORT=3000

# Optional, defaults to 0.0.0.0
OPENBEACON_API_HOSTNAME=0.0.0.0

# Optional, defaults to none; trusted-proxy uses the last X-Forwarded-For hop; cloudflare trusts CF-Connecting-IP, so only use it when the origin is reachable solely through Cloudflare
TRUSTED_PROXY_PROVIDER=none

# Required when TRUSTED_PROXY_PROVIDER=cloudflare-authenticated; at least 32 characters
CLOUDFLARE_ORIGIN_SECRET=

# Optional, hosted API only; HTTPS Discord webhook alerted on new feedback (no message or email is sent)
DISCORD_FEEDBACK_WEBHOOK_URL=

# Email (optional). Configure Resend or SMTP, not both. Leave both empty to turn email off.
# Resend API key; a sending-only key works
RESEND_API_KEY=

# SMTP server hostname
SMTP_HOST=

# Optional, defaults to 465 when SMTP_SECURE=true, otherwise 587
SMTP_PORT=

# Optional, true for implicit TLS; defaults to true only on port 465
SMTP_SECURE=

# Optional, defaults to true: refuse to send unless STARTTLS succeeds; false allows plaintext for a local relay
SMTP_REQUIRE_TLS=

# Optional, set together with SMTP_PASSWORD
SMTP_USER=

# Optional, set together with SMTP_USER
SMTP_PASSWORD=

# Sender address, required with Resend or SMTP; emails come from "OpenBeacon <EMAIL_FROM>"
EMAIL_FROM=

# Development only: true prints a one-line summary of each email (recipient, type, code) to the log instead of sending it; refused unless NODE_ENV is development or test
EMAIL_CONSOLE=

# Image storage for profile and group pictures, in any S3-compatible bucket
# Required, the S3 API address without the bucket in it; phones upload pictures to it directly, so it must be https:// outside local development
IMAGES_S3_ENDPOINT=

# Required, the bucket's region; use us-east-1 if your provider has none
IMAGES_S3_REGION=

# Required
IMAGES_S3_ACCESS_KEY_ID=

# Required
IMAGES_S3_ACCESS_KEY=

# Required
IMAGES_S3_BUCKET_NAME=

# Required, public address pictures are served from; links are built as <this>/<bucket>/<key>
IMAGES_S3_CDN_URL=

# Optional, defaults to false; set true for providers that need the bucket in the path, such as MinIO without a bucket domain
IMAGES_S3_FORCE_PATH_STYLE=

# Image Upload Limits
# Optional, defaults to 5MB (5242880 bytes)
MAX_IMAGE_FILE_SIZE=5242880

# Map storage for the world map, in any S3-compatible bucket; the backend, the job runner and the map tiles service all need these
# Required, the S3 API address without the bucket in it; phones download the map from it directly, so it must be https:// outside local development
MAP_S3_ENDPOINT=

# Required, the bucket's region; use us-east-1 if your provider has none
MAP_S3_REGION=

# Required
MAP_S3_ACCESS_KEY_ID=

# Required
MAP_S3_ACCESS_KEY=

# Required
MAP_S3_BUCKET_NAME=

# Optional, defaults to false; set true for providers that need the bucket in the path, such as MinIO without a bucket domain
MAP_S3_FORCE_PATH_STYLE=

# Map tiles service and its map-tiles command (apps/map-tiles)
# Optional, defaults to 30; must be more than 8
MAP_TILES_UPDATE_INTERVAL_DAYS=

# Optional, defaults to 8080; the service listens on 127.0.0.1 only
MAP_TILES_PORT=

# Optional upload and download cap in megabits per second
MAP_TILES_MAX_MBPS=

# Optional, defaults to .map-tiles; holds resumable upload state
MAP_TILES_STATE_DIR=
