# Copy this file to .env next to docker-compose.yml and fill in every value.

# Your server's domain, without https://. Phones connect to https://<this>.
OPENBEACON_DOMAIN=beacon.example.com

# Generate each secret with: openssl rand -hex 32
# Set them before the first start. PostgreSQL keeps the password it starts with,
# and changing BETTER_AUTH_SECRET later signs everyone out.
POSTGRES_PASSWORD=
STORAGE_SECRET_KEY=
BETTER_AUTH_SECRET=
REDIS_HASH_SECRET=
