{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!!**/dist",
      "!!**/build",
      "!!**/node_modules",
      "!!**/.claude",
      "!**/generated",
      "!**/.cxx",
      "!apps/mobile/global.css"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noComponentHookFactories": "warn",
        "noReactNativeRawText": "warn",
        "useExhaustiveDependencies": "warn",
        "useReactNativePlatformComponents": "warn",
        "useImportExtensions": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Alert"],
                    "message": "Use Alert from apps/mobile/lib/alert.ts so dialogs match the app's styling."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/lib/alert.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
