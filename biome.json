{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!!**/dist",
      "!!**/build",
      "!!**/node_modules",
      "!!**/.claude",
      "!**/generated",
      "!**/.cxx",
      "!apps/mobile/global.css"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noComponentHookFactories": "off",
        "noReactNativeRawText": "off",
        "useExhaustiveDependencies": "warn",
        "useReactNativePlatformComponents": "off",
        "useImportExtensions": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**", "packages/email/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "warn"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Alert"],
                    "message": "Use Alert from apps/mobile/lib/alert.ts so dialogs match the app's styling."
                  }
                }
              }
            }
          },
          "correctness": {
            "noReactNativeRawText": {
              "level": "warn",
              "options": {
                "skip": [
                  "button",
                  "CardDescription",
                  "CardTitle",
                  "DialogDescription",
                  "DialogTitle",
                  "Link"
                ]
              }
            },
            "useReactNativePlatformComponents": "warn"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/lib/alert.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/mobile/test/**",
        "apps/mobile/components/map/nativeMapTestHarness.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
            "useExhaustiveDependencies": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
