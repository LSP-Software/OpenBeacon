{
  "$schema": "https://biomejs.dev/schemas/2.3.12/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!!**/dist",
      "!!**/build",
      "!!**/node_modules",
      "!**/generated",
      "!**/.cxx",
      "!apps/mobile/global.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "useImportExtensions": "error"
      }
    }
  },
  "assist": {
    "enabled": true
  }
}