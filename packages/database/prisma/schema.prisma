generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  pendingUploads PendingUpload[]

  groupMembers               GroupMember[]
  devices                    UserDevice[]
  sentGroupMemberInvites     GroupMemberInvite[] @relation("GroupMemberInviteInviter")
  receivedGroupMemberInvites GroupMemberInvite[] @relation("GroupMemberInviteRecipient")
  groupEncryptedPayloads     GroupEncryptedPayload[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

enum ImageUploadType {
  userAvatar
  groupAvatar
}

model Group {
  id             String          @id @default(uuid(7))
  name           String
  image          String?
  pendingUploads PendingUpload[]

  groupMembers           GroupMember[]
  groupInvites           GroupMemberInvite[]
  groupEpochs            GroupEpoch[]
  groupEncryptedPayloads GroupEncryptedPayload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendingUpload {
  userId     String
  uploadType ImageUploadType
  fileName   String
  createdAt  DateTime        @default(now())
  groupId    String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, uploadType])
  @@index([groupId])
}

model GroupMemberInvite {
  id String @id @default(uuid(7))

  inviterId   String
  inviter     User      @relation("GroupMemberInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("GroupMemberInviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role        GroupRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipientId, groupId])
}

model GroupMember {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  role GroupRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, groupId])
}

model UserDevice {
  id                     String                   @id
  userId                 String
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey              String
  publicKeyAlgorithm     String
  createdAt              DateTime                 @default(now())
  lastSeenAt             DateTime                 @default(now())
  revokedAt              DateTime?
  createdGroupEpochs     GroupEpoch[]             @relation("GroupEpochCreatedByDevice")
  recipientEpochKeys     GroupEpochRecipientKey[] @relation("GroupEpochRecipientDevice")
  groupEncryptedPayloads GroupEncryptedPayload[]  @relation("GroupEncryptedPayloadSenderDevice")

  @@index([userId])
}

model GroupEpoch {
  id                     String                   @id
  groupId                String
  group                  Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  epochNumber            Int
  createdByDeviceId      String
  createdByDevice        UserDevice               @relation("GroupEpochCreatedByDevice", fields: [createdByDeviceId], references: [id], onDelete: Restrict)
  createdAt              DateTime                 @default(now())
  recipientKeys          GroupEpochRecipientKey[]
  groupEncryptedPayloads GroupEncryptedPayload[]

  @@unique([groupId, epochNumber])
  @@index([groupId, createdAt])
}

model GroupEncryptedPayload {
  id             String     @id @default(uuid(7))
  groupId        String
  group          Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  epochId        String
  epoch          GroupEpoch @relation(fields: [epochId], references: [id], onDelete: Restrict)
  senderDeviceId String
  senderDevice   UserDevice @relation("GroupEncryptedPayloadSenderDevice", fields: [senderDeviceId], references: [id], onDelete: Restrict)
  senderUserId   String
  senderUser     User       @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  kind           String
  algorithm      String
  nonce          String
  ciphertext     String
  clientPointId  String
  createdAt      DateTime   @default(now())

  @@unique([groupId, clientPointId])
  @@index([groupId, createdAt, id])
  @@index([groupId, senderUserId, createdAt])
  @@index([epochId])
  @@index([senderDeviceId])
  @@index([senderUserId])
}

model GroupEpochRecipientKey {
  id                 String     @id @default(uuid(7))
  groupEpochId       String
  groupEpoch         GroupEpoch @relation(fields: [groupEpochId], references: [id], onDelete: Cascade)
  recipientDeviceId  String
  recipientDevice    UserDevice @relation("GroupEpochRecipientDevice", fields: [recipientDeviceId], references: [id], onDelete: Restrict)
  wrappedKey         String
  ephemeralPublicKey String
  nonce              String
  algorithm          String
  createdAt          DateTime   @default(now())

  @@unique([groupEpochId, recipientDeviceId])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}
