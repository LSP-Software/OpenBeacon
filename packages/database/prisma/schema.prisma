generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String              @id
  name                       String
  email                      String              @unique(map: "user_email_unique")
  emailVerified              Boolean             @default(false) @map("email_verified")
  image                      String?
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")
  sessions                   Session[]
  accounts                   Account[]
  groupMembers               GroupMember[]
  devices                    UserDevice[]
  sentGroupMemberInvites     GroupMemberInvite[] @relation("GroupMemberInviteInviter")
  receivedGroupMemberInvites GroupMemberInvite[] @relation("GroupMemberInviteRecipient")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique(map: "session_token_unique")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_user_id_user_id_fk")

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_user_id_user_id_fk")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model Group {
  id    String  @id @default(uuid(7))
  name  String
  image String?

  groupMembers GroupMember[]
  groupInvites GroupMemberInvite[]
  groupEpochs  GroupEpoch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupMemberInvite {
  id String @id @default(uuid(7))

  inviterId   String
  inviter     User      @relation("GroupMemberInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("GroupMemberInviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role        GroupRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipientId, groupId])
}

model GroupMember {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  role GroupRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, groupId])
}

model UserDevice {
  id                 String                 @id
  userId             String                 @map("user_id")
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_device_user_id_user_id_fk")
  publicKey          String                 @map("public_key")
  publicKeyAlgorithm String                 @map("public_key_algorithm")
  createdAt          DateTime               @default(now()) @map("created_at")
  lastSeenAt         DateTime               @default(now()) @map("last_seen_at")
  revokedAt          DateTime?              @map("revoked_at")
  createdGroupEpochs GroupEpoch[]           @relation("GroupEpochCreatedByDevice")
  recipientEpochKeys GroupEpochRecipientKey[] @relation("GroupEpochRecipientDevice")

  @@index([userId], map: "user_device_userId_idx")
  @@map("user_device")
}

model GroupEpoch {
  id                String                  @id
  groupId           String                  @map("group_id")
  group             Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "group_epoch_group_id_group_id_fk")
  epochNumber       Int                     @map("epoch_number")
  createdByDeviceId String                  @map("created_by_device_id")
  createdByDevice   UserDevice              @relation("GroupEpochCreatedByDevice", fields: [createdByDeviceId], references: [id], onDelete: Restrict, map: "group_epoch_created_by_device_id_user_device_id_fk")
  createdAt         DateTime                @default(now()) @map("created_at")
  recipientKeys     GroupEpochRecipientKey[]

  @@unique([groupId, epochNumber], map: "group_epoch_groupId_epochNumber_unique")
  @@index([groupId, createdAt], map: "group_epoch_groupId_createdAt_idx")
  @@map("group_epoch")
}

model GroupEpochRecipientKey {
  id                String     @id @default(uuid(7))
  groupEpochId      String     @map("group_epoch_id")
  groupEpoch        GroupEpoch @relation(fields: [groupEpochId], references: [id], onDelete: Cascade, map: "group_epoch_recipient_key_group_epoch_id_group_epoch_id_fk")
  recipientDeviceId String     @map("recipient_device_id")
  recipientDevice   UserDevice @relation("GroupEpochRecipientDevice", fields: [recipientDeviceId], references: [id], onDelete: Restrict, map: "group_epoch_recipient_key_recipient_device_id_user_device_id_fk")
  wrappedKey        String     @map("wrapped_key")
  ephemeralPublicKey String    @map("ephemeral_public_key")
  nonce             String
  algorithm         String
  createdAt         DateTime   @default(now()) @map("created_at")

  @@unique([groupEpochId, recipientDeviceId], map: "group_epoch_recipient_key_groupEpochId_recipientDeviceId_unique")
  @@map("group_epoch_recipient_key")
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}
