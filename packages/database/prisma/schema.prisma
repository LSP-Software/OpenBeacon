generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  pendingDeletion Boolean        @default(false)
  deletionCancellationPending Boolean @default(false)
  deletionRetryAt DateTime?
  deletionDate   DateTime?
  timezone       String?
  alertNewDevice Boolean         @default(true)
  alertDeletionScheduled Boolean @default(true)
  sessions       Session[]
  accounts       Account[]
  pendingUploads PendingUpload[]
  googleDeletionChallenges GoogleDeletionChallenge[]

  groupMembers               GroupMember[]
  devices                    UserDevice[]
  sentGroupMemberInvites     GroupMemberInvite[] @relation("GroupMemberInviteInviter")
  receivedGroupMemberInvites GroupMemberInvite[] @relation("GroupMemberInviteRecipient")
  groupEncryptedPayloads     GroupEncryptedPayload[]
  groupJoinAlerts             GroupJoinAlert[] @relation("GroupJoinAlertRecipient")
  createdGroupJoinAlerts      GroupJoinAlert[] @relation("GroupJoinAlertMember")
  feedback                   Feedback[]
  createdSharedInvites       GroupSharedInvite[]
  recoveryKey                RecoveryKey?
  historyKeys                AccountHistoryKey[]

  @@index([pendingDeletion, deletionDate])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  googleDeletionChallenges GoogleDeletionChallenge[]

  @@index([userId])
  @@index([deviceId])
}

model GoogleDeletionChallenge {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nonce String
  codeVerifier String
  expiresAt DateTime

  @@index([userId])
  @@index([sessionId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

enum ImageUploadType {
  userAvatar
  groupAvatar
}

model Group {
  id             String          @id @default(uuid(7))
  name           String
  image          String?
  epochRotationRequired Boolean @default(false)
  groupMembers           GroupMember[]
  groupInvites           GroupMemberInvite[]
  sharedInvites          GroupSharedInvite[]
  joinAlerts             GroupJoinAlert[]
  groupEpochs            GroupEpoch[]
  groupEncryptedPayloads GroupEncryptedPayload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendingUpload {
  userId     String
  uploadType ImageUploadType
  fileName   String
  createdAt  DateTime        @default(now())
  groupId    String          @default("")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, uploadType, groupId])
  @@index([groupId])
}

model GroupMemberInvite {
  id String @id @default(uuid(7))

  inviterId   String
  inviter     User      @relation("GroupMemberInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("GroupMemberInviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role        GroupRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipientId, groupId])
}

model GroupSharedInvite {
  creatorId String?
  creator User? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  id        String   @id @default(uuid(7))
  codeHash  String   @unique
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model GroupJoinAlert {
  id          String   @id @default(uuid(7))
  recipientId String
  recipient   User     @relation("GroupJoinAlertRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  memberId    String?
  member      User?    @relation("GroupJoinAlertMember", fields: [memberId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberName  String
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
}

model GroupMember {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  role GroupRole
  joinedEpochNumber Int
  personalNicknames PersonalGroupNickname[] @relation("NicknameTarget")
  ownedNicknames PersonalGroupNickname[] @relation("NicknameOwner")
  personalColor PersonalGroupColor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, groupId])
}

model PersonalGroupNickname {
  ownerId String
  owner GroupMember @relation("NicknameOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId String
  target GroupMember @relation("NicknameTarget", fields: [targetId], references: [id], onDelete: Cascade)
  ciphertext String

  @@id([ownerId, targetId])
}

model PersonalGroupColor {
  ownerId String @id
  owner GroupMember @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ciphertext String
}

model UserDevice {
  id                     String                   @id
  userId                 String
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey              String
  publicKeyAlgorithm     String
  platform               String?
  model                  String?
  name                   String
  icon                   DeviceIcon
  createdAt              DateTime                 @default(now())
  lastSeenAt             DateTime                 @default(now())
  lastLocationAt         DateTime?
  activatedAt            DateTime?
  activatedBy            DeviceActivation?
  revokedAt              DateTime?
  sessions               Session[]
  createdGroupEpochs     GroupEpoch[]             @relation("GroupEpochCreatedByDevice")
  recipientEpochKeys     GroupEpochRecipientKey[] @relation("GroupEpochRecipientDevice")
  groupEncryptedPayloads GroupEncryptedPayload[]  @relation("GroupEncryptedPayloadSenderDevice")
  sentHistoryWraps       GroupEpochHistoryWrap[]

  @@index([userId])
}

enum DeviceIcon {
  phone
  tablet
  watch
  car
  laptop
  bag
  tag
  home
}

enum DeviceActivation {
  firstDevice
  link
  phrase
  reset
  existing
}

model GroupEpoch {
  id                     String                   @id
  groupId                String
  group                  Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  epochNumber            Int
  createdByDeviceId      String?
  createdByDevice        UserDevice?              @relation("GroupEpochCreatedByDevice", fields: [createdByDeviceId], references: [id], onDelete: SetNull)
  senderPublicKey        String
  createdAt              DateTime                 @default(now())
  recipientKeys          GroupEpochRecipientKey[]
  historyWraps           GroupEpochHistoryWrap[]
  groupEncryptedPayloads GroupEncryptedPayload[]

  @@unique([groupId, epochNumber])
  @@index([groupId, createdAt])
}

model GroupEncryptedPayload {
  id             String     @id @default(uuid(7))
  groupId        String
  group          Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  epochId        String
  epoch          GroupEpoch @relation(fields: [epochId], references: [id], onDelete: Restrict)
  senderDeviceId String
  senderDevice   UserDevice @relation("GroupEncryptedPayloadSenderDevice", fields: [senderDeviceId], references: [id], onDelete: Restrict)
  senderUserId   String
  senderUser     User       @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  kind           String
  algorithm      String
  nonce          String
  ciphertext     String
  clientPointId  String
  createdAt      DateTime   @default(now())

  @@unique([groupId, clientPointId])
  @@index([groupId, createdAt, id])
  @@index([groupId, senderUserId, createdAt])
  @@index([groupId, senderDeviceId, createdAt])
  @@index([epochId])
  @@index([senderDeviceId])
  @@index([senderUserId])
}

model GroupEpochRecipientKey {
  id                 String     @id @default(uuid(7))
  groupEpochId       String
  groupEpoch         GroupEpoch @relation(fields: [groupEpochId], references: [id], onDelete: Cascade)
  recipientDeviceId  String
  recipientDevice    UserDevice @relation("GroupEpochRecipientDevice", fields: [recipientDeviceId], references: [id], onDelete: Restrict)
  wrappedKey         String
  ephemeralPublicKey String
  algorithm          String
  createdAt          DateTime   @default(now())

  @@unique([groupEpochId, recipientDeviceId])
}

model RecoveryKey {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey         String
  algorithm         String
  derivationVersion Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AccountHistoryKey {
  id               String                  @id
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  version          Int
  publicKey        String
  algorithm        String
  escrowEnc        String?
  escrowCiphertext String?
  escrowAlgorithm  String?
  createdAt        DateTime                @default(now())
  historyWraps     GroupEpochHistoryWrap[]

  @@unique([userId, version])
}

model GroupEpochHistoryWrap {
  id                 String            @id @default(uuid(7))
  groupEpochId       String
  groupEpoch         GroupEpoch        @relation(fields: [groupEpochId], references: [id], onDelete: Cascade)
  historyKeyId       String
  historyKey         AccountHistoryKey @relation(fields: [historyKeyId], references: [id], onDelete: Cascade)
  senderDeviceId     String?
  senderDevice       UserDevice?       @relation(fields: [senderDeviceId], references: [id], onDelete: SetNull)
  senderPublicKey    String
  wrappedKey         String
  ephemeralPublicKey String
  algorithm          String
  createdAt          DateTime          @default(now())

  @@unique([groupEpochId, historyKeyId])
  @@index([historyKeyId])
  @@index([senderDeviceId])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model Feedback {
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String   @id @default(uuid(7))
  message   String
  email     String?
  androidVersion String?
  appVersion String?
  maplibreVersion String?
  serverVersion String?
  createdAt DateTime @default(now())
}

model AccountDeletionCleanup {
  userId String @id
  createdAt DateTime @default(now())
  retryAt DateTime?
  imageKeys String[] @default([])
}
