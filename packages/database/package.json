{
  "name": "@openbeacon/database",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./generated/client/browser.d.ts",
      "import": "./generated/client/browser.js",
      "default": "./generated/client/browser.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "DATABASE_URL=postgresql://localhost:5432/openbeacon prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "bun test --pass-with-no-tests",
    "db:generate": "bun run --env-file=../../.env prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "@prisma/adapter-pg": "^7.4.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "prisma": "^7.4.2"
  }
}
