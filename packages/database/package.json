{
  "name": "@openbeacon/database",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./databaseUrlSchema.ts": {
      "types": "./src/databaseUrlSchema.ts",
      "import": "./src/databaseUrlSchema.ts",
      "default": "./src/databaseUrlSchema.ts"
    },
    "./enums": {
      "types": "./generated/client/enums.ts",
      "import": "./generated/client/enums.ts",
      "default": "./generated/client/enums.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test --pass-with-no-tests --isolate",
    "db:generate": "bun run --env-file=../../.env prisma generate",
    "db:push": "bun run --env-file=../../.env prisma db push",
    "db:migrate:deploy": "bun run --env-file=../../.env prisma migrate deploy",
    "db:migrate": "bun run --env-file=../../.env prisma migrate dev",
    "db:migrate:reset": "bun run --env-file=../../.env prisma migrate reset",
    "db:studio": "bun run --env-file=../../.env prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^25.0.10",
    "prisma": "^7.10.1"
  }
}
