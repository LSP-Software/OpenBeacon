{
  "name": "@openbeacon/database",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "DATABASE_URL=postgresql://localhost:5432/openbeacon prisma generate && tsc -p tsconfig.json --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test --pass-with-no-tests",
    "db:generate": "bun run --env-file=../../.env prisma generate",
    "db:push": "bun run --env-file=../../.env prisma db push",
    "db:migrate:deploy": "bun run --env-file=../../.env prisma migrate deploy",
    "db:migrate": "bun run --env-file=../../.env prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "@prisma/adapter-pg": "^7.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "prisma": "^7.4.2"
  }
}
