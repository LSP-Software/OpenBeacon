# Disposable local backend used only for agent verification.
# Copy to a location OUTSIDE the repo (e.g. /tmp/ope98-verify.env) and never commit real values.
# The S3_* and R2_* values are required for the backend to boot and for MapLibre
# tiles to render; copy them from your own local backend .env.

BETTER_AUTH_SECRET=change-me-to-a-32-char-plus-random-string
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://openbeacon:openbeacon@localhost:5432/openbeacon_verify
REDIS_URL=redis://localhost:6379
OPENBEACON_API_PORT=3000
OPENBEACON_API_HOSTNAME=0.0.0.0
TRUSTED_PROXY_PROVIDER=none

# Emulator reaches the host backend at 10.0.2.2.
EXPO_PUBLIC_DEV_API_URL=http://10.0.2.2:3000

S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CDN_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PM_TILES_KEY=
